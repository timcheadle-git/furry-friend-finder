rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Owner-scoped pet images: /pets/{ownerUid}/{petId}/{filename}
    match /pets/{ownerUid}/{petId}/{allPaths=**} {
      allow read: if request.auth != null;

      // Only the owner can upload; files must be images under 5 MB.
      allow create, update: if request.auth != null
                            && request.auth.uid == ownerUid
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');

      // Deletes have no request.resource, so they need their own rule.
      allow delete: if request.auth != null && request.auth.uid == ownerUid;
    }

    // Default deny for other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
