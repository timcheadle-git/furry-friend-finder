rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Owner-scoped pet images: /pets/{ownerUid}/{petId}/{filename}
    match /pets/{ownerUid}/{petId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == ownerUid && request.resource.size < 5 * 1024 * 1024; // 5 MB limit
    }

    // Default deny for other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}