rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users: each person can read and manage only their own profile.
    // (User documents hold contact details such as email, phone and push tokens,
    // so other users must not be able to read them. Server code uses the Admin SDK,
    // which bypasses these rules.)
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid;
    }

    // Pets: readable by signed-in users; only the owner can create, change or delete.
    // ownerUid can never be changed after creation.
    match /pets/{petId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;
    }

    // Lost reports: readable by signed-in users; any signed-in user can file one as
    // themselves. Only the reporter (or an admin) can change or delete it, and
    // reporterUid can never be changed after creation.
    match /lostReports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.reporterUid == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.reporterUid == request.auth.uid
                        || request.auth.token.admin == true)
                    && request.resource.data.reporterUid == resource.data.reporterUid;
      allow delete: if request.auth != null
                    && (resource.data.reporterUid == request.auth.uid
                        || request.auth.token.admin == true);
    }

    // Subscriptions / opt-ins: private to the user they belong to.
    // userUid can never be changed after creation.
    match /subscriptions/{subId} {
      allow read, delete: if request.auth != null
                          && resource.data.userUid == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.userUid == request.auth.uid
                    && request.resource.data.userUid == resource.data.userUid;
    }

    // Alerts: written only by server code (Admin SDK bypasses these rules).
    match /alerts/{alertId} {
      allow read: if request.auth != null
                  && (resource.data.sentTo.hasAny([request.auth.uid])
                      || resource.data.ownerUid == request.auth.uid);
      allow create: if false;
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
